---
import '../styles/global.css';
import { getAllPartsAndChapters, getAllAppendices } from '../lib/content';
import SearchModal from '../components/SearchModal.astro';
import { ViewTransitions } from 'astro:transitions';

interface Props {
  title: string;
  description?: string;
}

const { title, description = "A software engineer's handbook — with a chapter for everyone else." } = Astro.props;
const { parts, chapters } = getAllPartsAndChapters();
const appendices = getAllAppendices();
const totalChapters = chapters.length + parts.length;

const base = import.meta.env.BASE_URL || '/';
const cleanBase = base.endsWith('/') ? base : base + '/';
const basePath = base.replace(/\/$/, '');
const currentPath = Astro.url.pathname.replace(/\/$/, '').replace(new RegExp('^' + basePath), '');

// Find which part is currently active
const activePartSlug = parts.find(
  (p) => currentPath === `/parts/${p.slug}` || p.chapters.some((ch) => currentPath === `/chapters/${ch.slug}`)
)?.slug;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/png" href={`${cleanBase}favicon.png?v=4`} />
    <title>{title} — So, What Do You Actually Do?</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={`${title} — So, What Do You Actually Do?`} />
    <meta property="og:description" content={description} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={`${title} — So, What Do You Actually Do?`} />
    <meta name="twitter:description" content={description} />
    <!-- Premium Editorial & Neo-Grotesque Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Newsreader:ital,opsz,wght@0,6..72,300..800;1,6..72,300..800&family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&family=IBM+Plex+Mono:ital,wght@0,300;0,400;0,500;0,600;0,700;1,300;1,400;1,500;1,600;1,700&display=swap" rel="stylesheet">
    <ViewTransitions />
    
    <!-- Theme initialisation (Runs immediately to prevent flashing) -->
    <script is:inline>
      const getTheme = () => {
        if (typeof localStorage !== 'undefined' && localStorage.getItem('theme')) {
          return localStorage.getItem('theme');
        }
        return window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
      };
      document.documentElement.setAttribute('data-theme', getTheme());
    </script>

    <!-- Reading track initialisation (Runs immediately to prevent layout flashes) -->
    <script is:inline>
      const getTrack = () => {
        try {
          const hash = window.location.hash;
          if (hash.includes('wife')) return 'wife';
          if (hash.includes('kids')) return 'kids';
          if (hash.includes('technical') || hash.includes('engineer')) return 'engineer';

          const stored = localStorage.getItem('selectedTrack');
          if (stored === 'engineer' || stored === 'wife' || stored === 'kids') return stored;
        } catch (e) {}
        return 'engineer';
      };
      document.documentElement.setAttribute('data-track', getTrack());
    </script>
  </head>
  <body>
    <div class="docs-layout" id="docsLayout">
      <!-- Inline script to apply minimized class before paint if stored -->
      <script is:inline>
        if (typeof localStorage !== 'undefined' && localStorage.getItem('sidebar-minimized') === 'true') {
          document.getElementById('docsLayout').classList.add('sidebar-minimized');
        }
      </script>
      <!-- Top Header -->
      <header class="docs-header" data-pagefind-ignore transition:persist>
        <div class="header-left">
          <button class="mobile-toggle" aria-label="Toggle Navigation" id="mobileToggle">
            <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2">
              <line x1="3" y1="12" x2="21" y2="12"></line>
              <line x1="3" y1="6" x2="21" y2="6"></line>
              <line x1="3" y1="18" x2="21" y2="18"></line>
            </svg>
          </button>
          
          <a class="brand" href={cleanBase}>
            <span class="brand-title">So, What Do You Actually Do?</span>
            <span class="brand-subtitle">A Software Engineer's Handbook</span>
          </a>
        </div>
        
        <div class="header-center">
          <button class="search-trigger-btn" onclick="window.openHandbookSearch()" aria-label="Search handbook">
            <svg class="search-trigger-icon" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2">
              <circle cx="11" cy="11" r="8"></circle>
              <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
            </svg>
            <span class="search-trigger-text">Search handbook...</span>
            <kbd class="search-trigger-kbd">⌘K</kbd>
          </button>
        </div>
        
        <div class="header-right">
          <!-- Reading Track Switcher -->
          <div class="track-switcher" id="trackSwitcher" role="group" aria-label="Reading track">
            <button type="button" class="track-switcher-btn" data-track="engineer" title="For Engineers">Engineer</button>
            <button type="button" class="track-switcher-btn" data-track="wife" title="For My Wife">Wife</button>
            <button type="button" class="track-switcher-btn" data-track="kids" title="For My Kids">Kids</button>
          </div>

          <!-- Theme Toggle -->
          <button class="theme-toggle" id="themeToggle" aria-label="Toggle Dark/Light Mode">
            <!-- Sun Icon (shown in dark mode) -->
            <svg class="sun-icon" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2">
              <circle cx="12" cy="12" r="5"></circle>
              <line x1="12" y1="1" x2="12" y2="3"></line>
              <line x1="12" y1="21" x2="12" y2="23"></line>
              <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line>
              <line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line>
              <line x1="1" y1="12" x2="3" y2="12"></line>
              <line x1="21" y1="12" x2="23" y2="12"></line>
              <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line>
              <line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line>
            </svg>
            <!-- Moon Icon (shown in light mode) -->
            <svg class="moon-icon" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
            </svg>
          </button>
        </div>
      </header>

      <div class="docs-body-container">
        <!-- Navigation Sidebar -->
        <aside class="docs-sidebar" id="sidebar" data-pagefind-ignore transition:persist>
          <nav class="sidebar-nav">
            <!-- Reading Progress Module -->
            <div class="sidebar-progress" id="sidebarProgress" data-total={totalChapters}>
              <div class="sidebar-progress-track">
                <div class="sidebar-progress-fill" id="sidebarProgressFill"></div>
              </div>
              <div class="sidebar-progress-row">
                <span class="sidebar-progress-label" id="sidebarProgressLabel">0 of {totalChapters} chapters</span>
                <button type="button" class="sidebar-progress-reset" id="sidebarProgressReset" title="Reset reading progress for this track" aria-label="Reset reading progress for this track">
                  <svg viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <polyline points="1 4 1 10 7 10"></polyline>
                    <path d="M3.51 15a9 9 0 1 0 2.13-9.36L1 10"></path>
                  </svg>
                </button>
              </div>
            </div>

            <div class="sidebar-section">
              <a href={cleanBase} class={`sidebar-link ${currentPath === '' ? 'active' : ''}`}>
                <svg class="sidebar-link-icon" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M3 10.5 12 3l9 7.5"></path>
                  <path d="M5 9.5V20a1 1 0 0 0 1 1h4v-6h4v6h4a1 1 0 0 0 1-1V9.5"></path>
                </svg>
                <span class="sidebar-link-text">Introduction</span>
              </a>
              <a href={`${cleanBase}sitemap`} class={`sidebar-link ${currentPath === '/sitemap' ? 'active' : ''}`}>
                <svg class="sidebar-link-icon" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <line x1="8" y1="6" x2="21" y2="6"></line>
                  <line x1="8" y1="12" x2="21" y2="12"></line>
                  <line x1="8" y1="18" x2="21" y2="18"></line>
                  <line x1="3" y1="6" x2="3.01" y2="6"></line>
                  <line x1="3" y1="12" x2="3.01" y2="12"></line>
                  <line x1="3" y1="18" x2="3.01" y2="18"></line>
                </svg>
                <span class="sidebar-link-text">Table of Contents</span>
              </a>
            </div>

            <!-- Collapsible Parts and Chapters -->
            {parts.map((part) => {
              const isCurrent = activePartSlug === part.slug;
              return (
                <div
                  class={`sidebar-group ${isCurrent ? '' : 'collapsed'}`}
                  data-part-slug={part.slug}
                  data-part-chapters={JSON.stringify(part.chapters.map(c => c.slug))}
                >
                  <button class="sidebar-group-header">
                    <div class="sidebar-group-header-left">
                      <span class="sidebar-part-num">
                        Part {part.romanNumber}
                        <span class="part-progress-indicator">
                          <svg class="part-check-icon" viewBox="0 0 24 24" width="10" height="10" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <polyline points="20 6 9 17 4 12"></polyline>
                          </svg>
                          <svg class="part-started-icon" viewBox="0 0 24 24" width="6" height="6" fill="currentColor" aria-hidden="true">
                            <circle cx="12" cy="12" r="10"></circle>
                          </svg>
                        </span>
                      </span>
                      <span class="sidebar-part-title">{part.title}</span>
                    </div>
                    <svg class="sidebar-group-chevron" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.5">
                      <polyline points="6 9 12 15 18 9"></polyline>
                    </svg>
                  </button>
                  <ul class="sidebar-list">
                    <li>
                      <a
                        href={`${cleanBase}parts/${part.slug}`}
                        class={`sidebar-chapter-link ${currentPath === `/parts/${part.slug}` ? 'active' : ''}`}
                        data-chapter-slug={part.slug}
                      >
                        <span class="chapter-num-slot">
                          <span class="chapter-num">{part.romanNumber}</span>
                          <svg class="chapter-check-icon" viewBox="0 0 24 24" width="11" height="11" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <polyline points="20 6 9 17 4 12"></polyline>
                          </svg>
                          <svg class="chapter-started-icon" viewBox="0 0 24 24" width="8" height="8" fill="currentColor" aria-hidden="true">
                            <circle cx="12" cy="12" r="10"></circle>
                          </svg>
                        </span>
                        <span class="sidebar-chapter-title-text">Part Overview</span>
                      </a>
                    </li>
                    {part.chapters.map((ch) => (
                      <li>
                        <a
                          href={`${cleanBase}chapters/${ch.slug}`}
                          class={`sidebar-chapter-link ${currentPath === `/chapters/${ch.slug}` ? 'active' : ''}`}
                          data-chapter-slug={ch.slug}
                        >
                          <span class="chapter-num-slot">
                            <span class="chapter-num">{ch.number}</span>
                            <svg class="chapter-check-icon" viewBox="0 0 24 24" width="11" height="11" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                              <polyline points="20 6 9 17 4 12"></polyline>
                            </svg>
                            <svg class="chapter-started-icon" viewBox="0 0 24 24" width="8" height="8" fill="currentColor" aria-hidden="true">
                              <circle cx="12" cy="12" r="10"></circle>
                            </svg>
                          </span>
                          <span class="sidebar-chapter-title-text">
                            <span class="t-default">{ch.title}</span>
                            {ch.kidsTitle && <span class="t-kids">{ch.kidsTitle}</span>}
                          </span>
                        </a>
                      </li>
                    ))}
                  </ul>
                </div>
              );
            })}

            <!-- Appendices -->
            {appendices.length > 0 && (
              <div class="sidebar-group">
                <span class="sidebar-group-static-title">Appendices</span>
                <ul class="sidebar-list">
                  {appendices.map((app) => (
                    <li>
                      <a href={`${cleanBase}appendices/${app.slug}`} class={`sidebar-chapter-link ${currentPath === `/appendices/${app.slug}` ? 'active' : ''}`}>
                        <span class="chapter-num">{app.letter}</span>
                        <span class="sidebar-chapter-title-text">{app.title}</span>
                      </a>
                    </li>
                  ))}
                </ul>
              </div>
            )}
            <!-- Sidebar Collapse Button -->
            <div class="sidebar-collapse-container">
              <button class="sidebar-collapse-toggle" id="sidebarCollapseToggle" aria-label="Minimize sidebar">
                <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.5">
                  <polyline points="15 18 9 12 15 6"></polyline>
                </svg>
              </button>
            </div>
          </nav>
        </aside>

        <!-- Main Content Area -->
        <main class="docs-main" data-pagefind-body transition:animate="slide">
          <slot />
        </main>
      </div>
    </div>

    <!-- Client-side Interactive Scripts -->
    <script>
      // Reading Progress: per-track "read chapters" state + sidebar indicators
      function getReadChapters(track: string): Record<string, boolean> {
        try {
          return JSON.parse(localStorage.getItem(`readChapters:${track}`) || '{}');
        } catch (e) {
          return {};
        }
      }

      function initDocsLayout() {
        const theme = localStorage.getItem('theme') || 'light';
        document.documentElement.setAttribute('data-theme', theme);
        
        const track = localStorage.getItem('selectedTrack') || 'engineer';
        document.documentElement.setAttribute('data-track', track);
        
        function updateProgressUI() {
          const track = document.documentElement.getAttribute('data-track') || 'engineer';
          const read = getReadChapters(track);
          const readSlugs = Object.keys(read).filter((slug) => read[slug]);

          let started: Record<string, boolean> = {};
          try {
            started = JSON.parse(localStorage.getItem(`startedChapters:${track}`) || '{}');
          } catch (e) {}

          const progressEl = document.getElementById('sidebarProgress');
          const total = Number(progressEl?.getAttribute('data-total') || 0);
          const count = readSlugs.length;

          const fill = document.getElementById('sidebarProgressFill');
          const label = document.getElementById('sidebarProgressLabel');
          if (fill) fill.style.width = total > 0 ? `${Math.min(100, (count / total) * 100)}%` : '0%';
          if (label) label.textContent = `${count} of ${total} chapters`;

          // Update chapters checkmark and started states
          document.querySelectorAll('.sidebar-chapter-link[data-chapter-slug]').forEach((link) => {
            const slug = link.getAttribute('data-chapter-slug');
            if (slug) {
              const isRead = !!read[slug];
              const isStarted = !!started[slug] && !isRead;
              link.classList.toggle('is-read', isRead);
              link.classList.toggle('is-started', isStarted);
            }
          });

          // Update parts checkmark and started states
          document.querySelectorAll('.sidebar-group[data-part-chapters]').forEach((group) => {
            const rawChapters = group.getAttribute('data-part-chapters') || '[]';
            let chapterSlugs: string[] = [];
            try {
              chapterSlugs = JSON.parse(rawChapters);
            } catch (e) {}

            if (chapterSlugs.length === 0) return;

            const readInPart = chapterSlugs.filter((slug) => read[slug]).length;
            const startedInPart = chapterSlugs.filter((slug) => started[slug]).length;

            const isCompleted = readInPart === chapterSlugs.length;
            const isStarted = !isCompleted && (readInPart > 0 || startedInPart > 0);

            group.classList.toggle('is-completed', isCompleted);
            group.classList.toggle('is-started', isStarted);
          });

          // Update active link class dynamically in persisted sidebar
          const currentPath = window.location.pathname.replace(/\/$/, '').replace(/\/index\.html$/, '');
          document.querySelectorAll('.sidebar-chapter-link').forEach((link) => {
            const href = link.getAttribute('href') || '';
            const hrefPath = new URL(href, window.location.origin).pathname.replace(/\/$/, '').replace(/\/index\.html$/, '');
            link.classList.toggle('active', hrefPath === currentPath);
          });

          // Auto-expand the active part's group in the sidebar
          const activeLink = document.querySelector('.sidebar-chapter-link.active');
          if (activeLink) {
            const group = activeLink.closest('.sidebar-group');
            if (group) {
              group.classList.remove('collapsed');
            }
          }
        }

        // Expose updateProgressUI globally so the global window listener can call it
        (window as any).triggerProgressUIUpdate = updateProgressUI;

        updateProgressUI();

        // Reset progress for the active track only.
        const trackLabels: Record<string, string> = { engineer: 'Engineer', wife: 'Wife', kids: 'Kids' };
        const resetBtn = document.getElementById('sidebarProgressReset');
        resetBtn?.addEventListener('click', () => {
          const track = document.documentElement.getAttribute('data-track') || 'engineer';
          const read = getReadChapters(track);
          const count = Object.values(read).filter(Boolean).length;
          const trackName = trackLabels[track] || track;
          const confirmed = window.confirm(
            `Reset your ${trackName} reading progress? This clears ${count} read chapter${count === 1 ? '' : 's'}.`
          );
          if (!confirmed) return;

          try {
            localStorage.removeItem(`readChapters:${track}`);
            localStorage.removeItem(`startedChapters:${track}`);
            localStorage.removeItem(`lastVisited:${track}`);
          } catch (e) {}
          window.dispatchEvent(new CustomEvent('reading-progress-updated', { detail: { track } }));
        });

        // Reading Track Switcher Logic
        document.querySelectorAll('.track-switcher-btn').forEach((btn) => {
          btn.addEventListener('click', () => {
            const track = btn.getAttribute('data-track');
            if (!track) return;
            document.documentElement.setAttribute('data-track', track);
            try {
              localStorage.setItem('selectedTrack', track);
            } catch (e) {}
            updateProgressUI();
          });
        });

        // Switch track based on URL hash
        function updateTrackFromHash() {
          const hash = window.location.hash;
          if (!hash) return;

          let targetTrack = null;
          if (hash.includes('wife')) {
            targetTrack = 'wife';
          } else if (hash.includes('kids')) {
            targetTrack = 'kids';
          } else if (hash.includes('technical') || hash.includes('engineer')) {
            targetTrack = 'engineer';
          }

          if (targetTrack) {
            document.documentElement.setAttribute('data-track', targetTrack);
            try {
              localStorage.setItem('selectedTrack', targetTrack);
            } catch (e) {}
            updateProgressUI();
          }
        }

        (window as any).triggerTrackFromHash = updateTrackFromHash;
        updateTrackFromHash();

        // Theme Toggle Logic
        const themeToggle = document.getElementById('themeToggle');
        themeToggle?.addEventListener('click', () => {
          const root = document.documentElement;
          const currentTheme = root.getAttribute('data-theme') || 'light';
          const nextTheme = currentTheme === 'light' ? 'dark' : 'light';
          root.setAttribute('data-theme', nextTheme);
          localStorage.setItem('theme', nextTheme);
        });

        // Sidebar Minimization Toggle
        const sidebarCollapseToggle = document.getElementById('sidebarCollapseToggle');
        const docsLayout = document.getElementById('docsLayout');
        sidebarCollapseToggle?.addEventListener('click', () => {
          const isMinimized = docsLayout?.classList.toggle('sidebar-minimized');
          localStorage.setItem('sidebar-minimized', String(isMinimized));
        });

        // Mobile Drawer Toggle
        const mobileToggle = document.getElementById('mobileToggle');
        const sidebar = document.getElementById('sidebar');
        mobileToggle?.addEventListener('click', (e) => {
          e.stopPropagation();
          sidebar?.classList.toggle('open');
        });

        // Sidebar Accordion Toggle
        const groupHeaders = document.querySelectorAll('.sidebar-group-header');
        groupHeaders.forEach((header) => {
          header.addEventListener('click', () => {
            const group = header.closest('.sidebar-group');
            group?.classList.toggle('collapsed');
          });
        });
      }

      // Key global window/document events should only be registered once
      if (!(window as any).hasLayoutGlobalListeners) {
        window.addEventListener('storage', (e) => {
          if (e.key && (e.key.startsWith('readChapters:') || e.key.startsWith('startedChapters:') || e.key.startsWith('lastVisited:'))) {
            if ((window as any).triggerProgressUIUpdate) {
              (window as any).triggerProgressUIUpdate();
            }
          }
        });
        window.addEventListener('reading-progress-updated', () => {
          if ((window as any).triggerProgressUIUpdate) {
            (window as any).triggerProgressUIUpdate();
          }
        });
        window.addEventListener('hashchange', () => {
          if ((window as any).triggerTrackFromHash) {
            (window as any).triggerTrackFromHash();
          }
        });
        document.addEventListener('click', (e) => {
          const target = e.target as HTMLElement;
          const sidebar = document.getElementById('sidebar');
          const mobileToggle = document.getElementById('mobileToggle');
          if (sidebar?.classList.contains('open') && !sidebar.contains(target) && target !== mobileToggle && !mobileToggle?.contains(target)) {
            sidebar.classList.remove('open');
          }

          // Override animation direction on sequential previous link clicks
          const link = target.closest('a');
          if (link) {
            if (link.classList.contains('footer-link--prev') || link.getAttribute('data-direction') === 'back') {
              (window as any).nextTransitionDirection = 'back';
            } else {
              (window as any).nextTransitionDirection = 'forward';
            }
          }
        });

        document.addEventListener('astro:before-preparation', (event: any) => {
          if ((window as any).nextTransitionDirection) {
            event.direction = (window as any).nextTransitionDirection;
          }
        });

        document.addEventListener('astro:after-swap', () => {
          // Restore theme and track properties immediately on page swap to prevent flashing
          const theme = localStorage.getItem('theme') || 'light';
          document.documentElement.setAttribute('data-theme', theme);
          
          const track = localStorage.getItem('selectedTrack') || 'engineer';
          document.documentElement.setAttribute('data-track', track);
        });

        (window as any).hasLayoutGlobalListeners = true;
      }

      // Initialize on initial page load and on page transitions
      document.addEventListener('astro:page-load', initDocsLayout);
    </script>
    <SearchModal />
  </body>
</html>
