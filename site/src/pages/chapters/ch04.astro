---
import fs from 'node:fs';
import path from 'node:path';
import ChapterLayout from '../../layouts/ChapterLayout.astro';
import ChapterTracks from '../../components/ChapterTracks';
import { buildEngineerHtml } from '../../lib/parseChapter';
import { demoContent } from '../../data/demoContent';

const repoRoot = path.resolve(process.cwd(), '..');
const rawMarkdown = fs.readFileSync(
  path.join(repoRoot, 'part01-systems-thinking', 'ch04-abstraction-and-information-hiding.md'),
  'utf-8'
);

const engineerHtml = buildEngineerHtml(rawMarkdown);
const { wife, kids } = demoContent.ch04;
---

<ChapterLayout chapterNumber="04" title="Abstraction and Information Hiding">
  <ChapterTracks client:load engineerHtml={engineerHtml} wifeHtml={wife} kidsHtml={kids} mascotEmoji="🦫" />
</ChapterLayout>
