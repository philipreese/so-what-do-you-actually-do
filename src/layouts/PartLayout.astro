---
import DocsLayout from './DocsLayout.astro';
import ReadingFooter from '../components/ReadingFooter.astro';

interface Props {
  partNumber: string;
  title: string;
  bannerEmoji?: string;
  bannerSrc?: string;
  eyebrow?: string;
}

const { partNumber, title, bannerEmoji = '🗺️', bannerSrc, eyebrow } = Astro.props;
const displayEyebrow = eyebrow || `Part ${partNumber}`;
const pathname = Astro.url.pathname.replace(/\/$/, '').replace(/\/index\.html$/, '');
const currentSlug = pathname.split('/').pop() || '';
---

<DocsLayout title={title}>
  <div class="part-container">
    <header class="part-header">
      <div class="part-banner" title="Part banner illustration placeholder">
        {bannerSrc ? <img src={bannerSrc} alt="" /> : <span class="part-banner-placeholder">{bannerEmoji}</span>}
      </div>
      <p class="chapter-eyebrow">{displayEyebrow}</p>
      <h1>{title}</h1>
    </header>
    
    <div class="part-content-slot">
      <div class="part-body">
        <slot />
      </div>
    </div>
  </div>
  
  <ReadingFooter currentSlug={currentSlug} type="part" />
</DocsLayout>
