---
import '../styles/global.css';

interface Props {
  partNumber: string;
  title: string;
  bannerEmoji?: string;
  bannerSrc?: string;
}

const { partNumber, title, bannerEmoji = '🗺️', bannerSrc } = Astro.props;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} — So, What Do You Actually Do?</title>
  </head>
  <body>
    <header class="site-header">
      <a class="brand" href="/">
        <span class="brand-title">So, What Do You Actually Do?</span>
        <span class="brand-subtitle">A Software Engineer's Handbook — With a Chapter for Everyone Else</span>
      </a>
    </header>

    <main class="part-main">
      <div class="part-banner" title="Part banner illustration placeholder">
        {bannerSrc ? <img src={bannerSrc} alt="" /> : <span class="part-banner-placeholder">{bannerEmoji}</span>}
      </div>
      <p class="chapter-eyebrow">Part {partNumber}</p>
      <h1>{title}</h1>
      <div class="part-body">
        <slot />
      </div>
    </main>
  </body>
</html>
