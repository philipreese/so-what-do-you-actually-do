---
import fs from 'node:fs';
import ChapterLayout from '../../layouts/ChapterLayout.astro';
import ChapterTracks from '../../components/ChapterTracks.astro';
import { getAllPartsAndChapters, getChapterImage, splitChapterTracks } from '../../lib/content';

export async function getStaticPaths() {
  const { chapters } = getAllPartsAndChapters();
  return chapters.map((ch) => ({
    params: { slug: ch.slug },
    props: { chapter: ch },
  }));
}

const { chapter } = Astro.props;
const rawMarkdown = fs.readFileSync(chapter.filePath, 'utf-8');

const { engineerHtml, wifeHtml, kidsHtml, headings, subtitle, thesis } = splitChapterTracks(rawMarkdown);
const imageSrc = getChapterImage(chapter.number);
---

<ChapterLayout
  chapterNumber={chapter.number}
  title={chapter.title}
  kidsTitle={chapter.kidsTitle}
  subtitle={subtitle}
  kidsSubtitle={chapter.kidsSubtitle}
  thesis={thesis}
  kidsThesis={chapter.kidsThesis}
  headings={headings}
  imageSrc={imageSrc}
>
  <ChapterTracks engineerHtml={engineerHtml} wifeHtml={wifeHtml} kidsHtml={kidsHtml} />
</ChapterLayout>
