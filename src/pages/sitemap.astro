---
import DocsLayout from '../layouts/DocsLayout.astro';
import { getAllPartsAndChapters, getAllAppendices } from '../lib/content';

const { parts } = getAllPartsAndChapters();
const appendices = getAllAppendices();
---

<DocsLayout title="Table of Contents">
  <div class="sitemap-container">
    <h1>Table of Contents</h1>
    
    <div class="parts-grid-sitemap">
      {parts.map((part) => (
        <div class="sitemap-part-card">
          <a href={`/parts/${part.slug}`} class="sitemap-part-header">
            <span class="sitemap-part-emoji">{part.emoji}</span>
            <div class="sitemap-part-meta">
              <span class="sitemap-part-num">Part {part.romanNumber}</span>
              <h2 class="sitemap-part-title">{part.title}</h2>
            </div>
          </a>
          <ul class="sitemap-chapters-list">
            {part.chapters.map((ch) => (
              <li>
                <a href={`/chapters/${ch.slug}`} class="sitemap-chapter-link">
                  <span class="sitemap-ch-num">{ch.number}</span>
                  <span class="sitemap-ch-text">
                    <span class="sitemap-ch-title">{ch.title}</span>
                    {ch.subtitle && <span class="sitemap-ch-subtitle">{ch.subtitle}</span>}
                  </span>
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>

    {appendices.length > 0 && (
      <div class="sitemap-appendices">
        <h2>Appendices</h2>
        <div class="sitemap-appendices-list">
          {appendices.map((app) => (
            <a href={`/appendices/${app.slug}`} class="sitemap-appendix-link">
              Appendix {app.letter} — {app.title}
            </a>
          ))}
        </div>
      </div>
    )}
  </div>
</DocsLayout>
