---
import DocsLayout from './DocsLayout.astro';
import ReadingFooter from '../components/ReadingFooter.astro';

interface HeadingItem {
  title: string;
  slug: string;
}

interface Props {
  chapterNumber: string;
  title: string;
  kidsTitle?: string;
  subtitle?: string;
  thesis?: string;
  headings?: HeadingItem[];
  imageSrc?: string;
}

const { chapterNumber, title, kidsTitle, subtitle = '', thesis = '', headings = [], imageSrc } = Astro.props;
const pathname = Astro.url.pathname.replace(/\/$/, '').replace(/\/index\.html$/, '');
const currentSlug = pathname.split('/').pop() || '';
---

<DocsLayout title={title} description={subtitle || undefined}>
  <div class="docs-content-container">
    <div class="chapter-container" data-chapter-slug={currentSlug}>
      <header class="chapter-header">
        <div class="chapter-header-row">
          <div class="chapter-header-left">
            <p class="chapter-eyebrow">Chapter {chapterNumber}</p>
            <h1>
              <span class="t-default">{title}</span>
              {kidsTitle && <span class="t-kids">{kidsTitle}</span>}
            </h1>
            {subtitle && <p class="chapter-subtitle">{subtitle}</p>}
            {thesis && <p class="chapter-thesis">{thesis}</p>}
          </div>
          {imageSrc && (
            <div class="chapter-header-image">
              <img src={imageSrc} alt="" />
            </div>
          )}
        </div>
      </header>
      <div class="chapter-content-slot">
        <slot />
      </div>
    </div>
    
    {headings && headings.length > 0 && (
      <aside class="toc-sidebar" data-pagefind-ignore>
        <div class="toc-title">On this page</div>
        <ul class="toc-list">
          <li>
            <a href="#" class="toc-link active">Overview</a>
          </li>
          {headings.map((h) => (
            <li>
              <a href={`#${h.slug}`} class="toc-link">{h.title}</a>
            </li>
          ))}
        </ul>
      </aside>
    )}
  </div>
  
  <div class="read-toggle-row">
    <button type="button" class="read-toggle-btn" id="readToggleBtn" data-slug={currentSlug}>Mark as read</button>
  </div>

  <div class="celebration-anchor" id="celebrationAnchor" aria-live="polite"></div>
  <ReadingFooter currentSlug={currentSlug} type="chapter" />
</DocsLayout>

<script>
  // Intersection Observer for Right Sidebar ToC Highlight (Scroll Spy)
  // Listen to scroll events on the .pane-engineer since it's the scrollable content pane
  function setupScrollSpy() {
    const scroller = document.querySelector('.pane-engineer');
    const tocLinks = document.querySelectorAll('.toc-link');
    
    if (scroller && tocLinks.length > 0) {
      const observerOptions = {
        root: scroller,
        rootMargin: '-10% 0px -70% 0px',
        threshold: 0
      };
 
      const observer = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            const id = entry.target.getAttribute('id');
            if (id) {
              tocLinks.forEach((link) => {
                if (link.getAttribute('href') === `#${id}`) {
                  link.classList.add('active');
                } else {
                  link.classList.remove('active');
                }
              });
            }
          }
        });
      }, observerOptions);
 
      // Observe all sections inside scroller that have an ID
      const sections = scroller.querySelectorAll('section[id]');
      sections.forEach((section) => observer.observe(section));
 
      // Handle scroll to top (highlight Overview link)
      scroller.addEventListener('scroll', () => {
        if (scroller.scrollTop < 80) {
          tocLinks.forEach((link) => {
            if (link.getAttribute('href') === '#') {
              link.classList.add('active');
            } else {
              link.classList.remove('active');
            }
          });
        }
      });
    }
  }

  // Run on load and after dynamic pane changes
  setupScrollSpy();

  // Watch for click events on the toggle to re-initialize scroll spy
  document.getElementById('toggle-secondary-btn')?.addEventListener('click', () => setTimeout(setupScrollSpy, 150));
</script>

<script>
  // Reading Progress: per-track "read chapter" + "last visited" tracking.
  //
  // A chapter counts as read for a track once the reader has (a) reached the
  // bottom of that track's visible pane — via a sentinel element observed with
  // an IntersectionObserver rooted on the pane's own scroll container — AND
  // (b) spent at least a minimum dwell time on the page. Short sections that
  // fit on screen without scrolling satisfy (a) immediately and simply wait
  // out the dwell timer.
  const DWELL_MS = 3000;
  const pageLoadTime = Date.now();

  const currentSlug = document.querySelector('.chapter-container')?.getAttribute('data-chapter-slug') || '';

  function currentTrack(): string {
    return document.documentElement.getAttribute('data-track') || 'engineer';
  }

  function getReadChapters(track: string): Record<string, boolean> {
    try {
      return JSON.parse(localStorage.getItem(`readChapters:${track}`) || '{}');
    } catch (e) {
      return {};
    }
  }

  function recordLastVisited(track: string) {
    if (!currentSlug) return;
    try {
      localStorage.setItem(`lastVisited:${track}`, currentSlug);
    } catch (e) {}
  }

  // Record immediately, then keep it in sync if the reader switches tracks
  // while still on this chapter.
  recordLastVisited(currentTrack());

  const paneBottomReached: Record<string, boolean> = { engineer: false, wife: false, kids: false };
  const alreadyHandled: Record<string, boolean> = { engineer: false, wife: false, kids: false };
  // Once a reader manually un-marks a chapter as read, don't let the
  // scroll/dwell auto-marker immediately flip it back to read for the rest
  // of this page view.
  const manualUnmarkSuppressed: Record<string, boolean> = { engineer: false, wife: false, kids: false };

  function totalChapterCount(): number {
    return Number(document.getElementById('sidebarProgress')?.getAttribute('data-total') || 0);
  }

  function celebrate(readCount: number) {
    const anchor = document.getElementById('celebrationAnchor');
    if (!anchor) return;
    anchor.innerHTML = '';

    const toast = document.createElement('div');
    toast.className = 'celebration-toast';
    toast.textContent = `${readCount} of ${totalChapterCount()}!`;
    anchor.appendChild(toast);

    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (!reduceMotion) {
      const burst = document.createElement('div');
      burst.className = 'celebration-confetti';
      const colors = ['#209fb5', '#ec4899', '#f0c975', '#7287fd', '#40a02b'];
      for (let i = 0; i < 18; i++) {
        const piece = document.createElement('span');
        piece.className = 'confetti-piece';
        piece.style.setProperty('--x', `${Math.round((Math.random() - 0.5) * 220)}px`);
        piece.style.setProperty('--rot', `${Math.round((Math.random() - 0.5) * 360)}deg`);
        piece.style.setProperty('--delay', `${(Math.random() * 0.15).toFixed(2)}s`);
        piece.style.background = colors[i % colors.length];
        burst.appendChild(piece);
      }
      anchor.appendChild(burst);
      setTimeout(() => burst.remove(), 1200);
    }

    setTimeout(() => toast.classList.add('celebration-toast--fade'), 2200);
    setTimeout(() => toast.remove(), 2700);
  }

  function maybeMarkRead(track: string) {
    if (!currentSlug || alreadyHandled[track] || !paneBottomReached[track]) return;
    if (manualUnmarkSuppressed[track]) return;
    if (Date.now() - pageLoadTime < DWELL_MS) return;

    alreadyHandled[track] = true;

    const read = getReadChapters(track);
    if (read[currentSlug]) return; // already marked in a previous visit

    read[currentSlug] = true;
    try {
      localStorage.setItem(`readChapters:${track}`, JSON.stringify(read));
    } catch (e) {}

    window.dispatchEvent(new CustomEvent('reading-progress-updated', { detail: { track, slug: currentSlug } }));

    if (track === 'kids') {
      const count = Object.values(read).filter(Boolean).length;
      celebrate(count);
    }
  }

  // One IntersectionObserver per track, rooted on that track's own scrollable
  // pane, watching the sentinel at the bottom of its content.
  const paneSelectors: Record<string, string> = {
    engineer: '.pane-engineer',
    wife: '.pane-secondary--wife',
    kids: '.pane-secondary--kids',
  };

  Object.entries(paneSelectors).forEach(([track, selector]) => {
    const scroller = document.querySelector(`${selector} .pane-content`);
    const sentinel = scroller?.querySelector('.pane-end-sentinel');
    if (!scroller || !sentinel) return;

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            paneBottomReached[track] = true;
            maybeMarkRead(track);
          }
        });
      },
      { root: scroller, threshold: 0 }
    );
    observer.observe(sentinel);
  });

  // Dwell-time fallback: catches panes whose sentinel was already
  // intersecting (content shorter than the pane) before the dwell elapsed.
  setTimeout(() => {
    Object.keys(paneBottomReached).forEach((track) => maybeMarkRead(track));
  }, DWELL_MS + 50);

  // Manual "Mark as read / mark as unread" toggle, near the reading footer.
  const readToggleBtn = document.getElementById('readToggleBtn') as HTMLButtonElement | null;

  function updateReadToggleUI() {
    if (!readToggleBtn || !currentSlug) return;
    const track = currentTrack();
    const isRead = !!getReadChapters(track)[currentSlug];
    readToggleBtn.classList.toggle('is-read', isRead);
    readToggleBtn.textContent = isRead ? '✓ Read · mark as unread' : 'Mark as read';
  }

  readToggleBtn?.addEventListener('click', () => {
    if (!currentSlug) return;
    const track = currentTrack();
    const read = getReadChapters(track);
    const willBeRead = !read[currentSlug];

    if (willBeRead) {
      read[currentSlug] = true;
    } else {
      delete read[currentSlug];
      // Prevent the scroll/dwell observer from immediately re-marking this
      // chapter as read for the rest of this page view.
      manualUnmarkSuppressed[track] = true;
    }

    try {
      localStorage.setItem(`readChapters:${track}`, JSON.stringify(read));
    } catch (e) {}

    window.dispatchEvent(new CustomEvent('reading-progress-updated', { detail: { track, slug: currentSlug } }));
    updateReadToggleUI();
  });

  updateReadToggleUI();

  // Keep the "last visited" bookmark current, and re-check read eligibility,
  // whenever the reader switches tracks while on this chapter.
  const trackObserver = new MutationObserver(() => {
    const track = currentTrack();
    recordLastVisited(track);
    maybeMarkRead(track);
    updateReadToggleUI();
  });
  trackObserver.observe(document.documentElement, { attributes: true, attributeFilter: ['data-track'] });
</script>
