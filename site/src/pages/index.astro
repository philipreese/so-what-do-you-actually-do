---
import DocsLayout from '../layouts/DocsLayout.astro';
---

<DocsLayout title="A Software Engineer's Handbook">
  <div class="hero-container">
    <div class="hero-content">
      <div class="hero-badge">
        <span class="badge-icon">⚡</span>
        <span class="badge-text">Interactive Edition</span>
      </div>
      <h1>So, What Do You Actually Do?</h1>
      <p class="hero-lead">
        A deep-dive handbook for senior software engineers, system architects, and technical leaders — with parallel tracks designed for your family, teammates, and stakeholders.
      </p>
      
      <div class="hero-buttons">
        <a href="/parts/part01" class="btn btn--primary">
          Start Reading <span class="btn-arrow">→</span>
        </a>
        <a href="/sitemap" class="btn btn--secondary">
          Table of Contents
        </a>
      </div>
    </div>

    <div class="hero-grid">
      <div class="grid-card card-engineer">
        <h3>For Engineers</h3>
        <p>The full, deep-dive technical handbook detailing distributed systems, code organization, concurrency, performance, and low-level architecture trade-offs.</p>
      </div>

      <div class="grid-card card-wife">
        <h3>For My Wife</h3>
        <p>A warm, jargon-free translation of every chapter's core argument and real-world stakes, written for smart, curious non-engineers.</p>
      </div>

      <div class="grid-card card-kids">
        <h3>For My Kids</h3>
        <p>Approachable, simplified explanations of core computing concepts using fun, everyday analogies and friendly mascot illustrations.</p>
      </div>
    </div>
  </div>
</DocsLayout>

<style>
  .hero-container {
    max-width: 900px;
    margin: 0 auto;
    padding: 4rem 0;
    display: flex;
    flex-direction: column;
    gap: 4.5rem;
    position: relative;
  }
  
  /* Modern neon nebula mesh backdrop glows */
  .hero-container::before {
    content: "";
    position: absolute;
    top: 5%;
    right: -10%;
    width: 450px;
    height: 450px;
    background: radial-gradient(circle, var(--accent-low) 0%, transparent 70%);
    pointer-events: none;
    z-index: -1;
  }
  
  .hero-container::after {
    content: "";
    position: absolute;
    bottom: 10%;
    left: -15%;
    width: 400px;
    height: 400px;
    background: radial-gradient(circle, var(--accent-low) 0%, transparent 70%);
    pointer-events: none;
    z-index: -1;
  }
  
  .hero-content {
    text-align: left;
  }
  
  .hero-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.35rem 0.85rem;
    background: var(--vocab-chip-bg);
    border: 1.5px solid var(--border-color);
    border-radius: 4px;
    font-size: 0.72rem;
    font-weight: 700;
    color: var(--text-color);
    margin-bottom: 1.5rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }
  
  .hero-content h1 {
    font-size: 4rem;
    font-weight: 500;
    line-height: 1.05;
    letter-spacing: -0.03em;
    margin-bottom: 1.5rem;
    color: var(--text-color);
  }
  
  .hero-lead {
    font-family: 'Newsreader', Georgia, serif;
    font-size: 1.35rem;
    line-height: 1.6;
    color: var(--text-muted);
    max-width: 720px;
    margin-bottom: 2.5rem;
  }
  
  .hero-buttons {
    display: flex;
    gap: 1.25rem;
    flex-wrap: wrap;
  }
  
  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.75rem 1.75rem;
    border-radius: 4px;
    font-size: 0.88rem;
    font-weight: 700;
    font-family: 'Plus Jakarta Sans', sans-serif;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
  }
  
  .btn--primary {
    background: var(--accent-color);
    color: white;
    box-shadow: 0 4px 14px rgba(114, 135, 253, 0.2);
  }
  
  [data-theme="dark"] .btn--primary {
    color: #181926; /* High contrast dark text on lavender button in dark mode */
  }

  .btn--primary:hover {
    background: var(--accent-hover);
    color: white;
    transform: translateY(-2px);
    box-shadow: 0 6px 20px rgba(114, 135, 253, 0.3);
  }
  
  [data-theme="dark"] .btn--primary:hover {
    color: #181926;
  }

  .btn-arrow {
    margin-left: 0.5rem;
    transition: transform 0.2s ease;
  }
  
  .btn--primary:hover .btn-arrow {
    transform: translateX(4px);
  }
  
  .btn--secondary {
    background: var(--card-bg);
    color: var(--text-color);
    border: 1.5px solid var(--border-color);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
  }
  
  .btn--secondary:hover {
    background: var(--sidebar-link-hover-bg);
    border-color: var(--border-focus);
    transform: translateY(-2px);
  }
  
  .hero-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 2rem;
  }
  
  .grid-card {
    position: relative;
    background: var(--card-bg);
    border: 2.5px solid var(--border-color);
    border-radius: 8px;
    padding: 2rem 1.75rem;
    box-shadow: 0 4px 30px rgba(0, 0, 0, 0.01);
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    overflow: hidden;
  }
  
  .card-engineer {
    border-left: 6px solid #1e66f5; /* Catppuccin Blue */
  }
  
  [data-theme="dark"] .card-engineer {
    border-left-color: #8cadfa;
  }

  .card-wife {
    border-left: 6px solid #e11d48; /* Red/Rose */
  }
  
  [data-theme="dark"] .card-wife {
    border-left-color: #fda4af;
  }

  .card-kids {
    border-left: 6px solid #df8e1d; /* Yellow/Amber */
  }
  
  [data-theme="dark"] .card-kids {
    border-left-color: #eed49f;
  }

  .grid-card:hover {
    transform: translateY(-3px);
    border-color: var(--border-focus);
    box-shadow: 0 12px 30px -10px rgba(114, 135, 253, 0.2), 0 4px 12px -8px rgba(0, 0, 0, 0.05);
  }
  
  .grid-card h3 {
    font-size: 1.35rem;
    margin-bottom: 0.75rem;
    font-weight: 500;
    font-family: 'Newsreader', Georgia, serif;
  }
  
  .grid-card p {
    font-size: 0.92rem;
    color: var(--text-muted);
    line-height: 1.55;
    margin: 0;
  }
</style>
