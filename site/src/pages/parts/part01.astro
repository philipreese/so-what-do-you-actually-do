---
import fs from 'node:fs';
import path from 'node:path';
import { marked } from 'marked';
import PartLayout from '../../layouts/PartLayout.astro';

const repoRoot = path.resolve(process.cwd(), '..');
const rawReadme = fs.readFileSync(path.join(repoRoot, 'part01-systems-thinking', 'README.md'), 'utf-8');

// Drop the leading "# Part I — ..." heading; the layout already renders the title.
const bodyMarkdown = rawReadme
  .replace(/^#[^\n]*\n/, '')
  // Only Ch 01 and Ch 04 exist as pages in this scaffold — link those, leave the rest as plain text.
  .replace('What Engineering Actually Optimizes', '[What Engineering Actually Optimizes](/chapters/ch01)')
  .replace('Abstraction and Information Hiding', '[Abstraction and Information Hiding](/chapters/ch04)');

const bodyHtml = marked.parse(bodyMarkdown) as string;
---

<PartLayout partNumber="I" title="Systems Thinking" bannerEmoji="🧭">
  <Fragment set:html={bodyHtml} />
</PartLayout>
