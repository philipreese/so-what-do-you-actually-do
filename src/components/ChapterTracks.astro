---
interface Props {
  engineerHtml: string;
  wifeHtml: string;
  kidsHtml: string;
}

const { engineerHtml, wifeHtml, kidsHtml } = Astro.props;
---

<div class="chapter-tracks" id="tracks-wrapper">
  <!-- Inline Initializer: Runs synchronously BEFORE paint to prevent layout flashes -->
  <script is:inline>
    (function() {
      const STORAGE_KEY = 'secondaryCollapsed';

      let collapsed = false;
      try {
        const urlParams = new URLSearchParams(window.location.search);
        const viewParam = urlParams.get('view');
        if (viewParam !== null) {
          collapsed = viewParam === 'collapsed';
        } else {
          const stored = window.localStorage.getItem(STORAGE_KEY);
          if (stored !== null) {
            collapsed = stored === 'true';
          } else {
            collapsed = false; // Expanded first time
          }
        }
      } catch (e) {}

      const wrapper = document.getElementById('tracks-wrapper');
      if (wrapper && collapsed) {
        wrapper.classList.add('secondary-collapsed');
      }

      const toggleBtn = document.getElementById('toggle-secondary-btn');
      if (toggleBtn) {
        toggleBtn.setAttribute('aria-pressed', String(!collapsed));
        const carets = toggleBtn.querySelectorAll('.vertical-tab-caret');
        carets.forEach(function(c) {
          c.textContent = collapsed ? '◀' : '▶';
        });
      }
    })();
  </script>

  <div class="track-panes">
    <!-- Engineer Pane -->
    <div class="pane pane-engineer">
      <div class="pane-header">
        <h2 class="pane-label" id="technical-reference">Technical Reference</h2>
      </div>
      <div class="pane-content">
        <div set:html={engineerHtml} />
        <div class="pane-end-sentinel" aria-hidden="true"></div>
      </div>
    </div>

    <!-- Wrapper for collapsible height transition on mobile -->
    <div class="mobile-collapse-wrapper">
      <!-- Secondary Stack (Wife & Kids, shown together by default) -->
      <div class="secondary-stack" id="secondaryStack">
        <!-- Wife Pane -->
        <div class="pane pane-secondary pane-secondary--wife">
          <div class="pane-header">
            <h2 class="pane-label" id="for-my-wife">For My Wife</h2>
          </div>
          <div class="pane-content">
            <div set:html={wifeHtml} />
            <div class="pane-end-sentinel" aria-hidden="true"></div>
          </div>
        </div>

        <!-- Kids Pane -->
        <div class="pane pane-secondary pane-secondary--kids">
          <div class="pane-header">
            <h2 class="pane-label" id="for-my-kids">For My Kids</h2>
          </div>
          <div class="pane-content">
            <div set:html={kidsHtml} />
            <div class="pane-end-sentinel" aria-hidden="true"></div>
          </div>
        </div>
      </div>
    </div>

    <!-- Vertical tab: collapses/expands the Wife + Kids panes together -->
    <button
      type="button"
      class="tracks-vertical-tab"
      id="toggle-secondary-btn"
      aria-label="Toggle For My Wife and For My Kids panes"
      aria-pressed="true"
    >
      <span class="vertical-tab-caret">▶</span>
      <span class="tracks-vertical-tab-label">For My Wife &amp; Kids</span>
      <span class="vertical-tab-caret">▶</span>
    </button>
  </div>
</div>

<script>
  document.addEventListener('astro:page-load', () => {
    const STORAGE_KEY = 'secondaryCollapsed';

    const wrapper = document.getElementById('tracks-wrapper');
    const toggleBtn = document.getElementById('toggle-secondary-btn');
    if (!toggleBtn) return;

    function isCollapsed(): boolean {
      return wrapper?.classList.contains('secondary-collapsed') ?? false;
    }

    function setCollapsed(collapsed: boolean) {
      wrapper?.classList.toggle('secondary-collapsed', collapsed);
      toggleBtn?.setAttribute('aria-pressed', String(!collapsed));
      window.localStorage.setItem(STORAGE_KEY, String(collapsed));

      const isMobile = window.matchMedia('(max-width: 900px)').matches;
      const carets = toggleBtn?.querySelectorAll('.vertical-tab-caret');
      carets?.forEach((c) => {
        if (isMobile) {
          c.textContent = collapsed ? '▼' : '▲';
        } else {
          c.textContent = collapsed ? '◀' : '▶';
        }
      });

      // Update URL query param to reflect view state; clean it up for the default (expanded) view
      const url = new URL(window.location.href);
      if (collapsed) {
        url.searchParams.set('view', 'collapsed');
      } else {
        url.searchParams.delete('view');
      }
      window.history.replaceState({}, '', url);
    }

    toggleBtn?.addEventListener('click', () => setCollapsed(!isCollapsed()));

    // Restore state from localStorage or query parameter (defaults to expanded)
    const urlParams = new URLSearchParams(window.location.search);
    const viewParam = urlParams.get('view');
    let initialCollapsed = false;
    if (viewParam !== null) {
      initialCollapsed = viewParam === 'collapsed';
    } else {
      const stored = window.localStorage.getItem(STORAGE_KEY);
      if (stored !== null) {
        initialCollapsed = stored === 'true';
      } else {
        initialCollapsed = false; // Expanded first time
      }
    }

    setCollapsed(initialCollapsed);

    // Listen to media query changes (resize crossing 900px) and update carets immediately
    const mediaQuery = window.matchMedia('(max-width: 900px)');
    mediaQuery.addEventListener('change', () => {
      setCollapsed(isCollapsed());
    });
  });
</script>
