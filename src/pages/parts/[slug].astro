---
import fs from 'node:fs';
import { marked } from 'marked';
import PartLayout from '../../layouts/PartLayout.astro';
import { getAllPartsAndChapters, getPartImage } from '../../lib/content';

export async function getStaticPaths() {
  const { parts } = getAllPartsAndChapters();
  return parts.map((part) => ({
    params: { slug: part.slug },
    props: { part },
  }));
}

const { part } = Astro.props;
const rawIntro = fs.readFileSync(part.filePath, 'utf-8');

// Drop the leading "# Part I — ..." heading; the layout already renders the title.
let bodyMarkdown = rawIntro.replace(/^#[^\n]*\n/, '');

const base = import.meta.env.BASE_URL || '/';
const cleanBase = base.endsWith('/') ? base : base + '/';

// Dynamically link all chapters in this part
for (const ch of part.chapters) {
  bodyMarkdown = bodyMarkdown.replace(ch.title, `[${ch.title}](${cleanBase}chapters/${ch.slug})`);
}

const bodyHtml = marked.parse(bodyMarkdown) as string;
const bannerSrc = getPartImage(part.number);
---

<PartLayout partNumber={part.romanNumber} title={part.title} bannerEmoji={part.emoji} bannerSrc={bannerSrc}>
  <Fragment set:html={bodyHtml} />
</PartLayout>
